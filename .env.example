# Copy to .env (never commit .env) and fill in.

# --- Otari ---
# Your otari.ai API key (Dashboard -> API keys). Used for chat.
OTARI_API_KEY=otk_your-otari-key
# Optional: base URL. Hosted Otari is https://api.otari.ai/api/v1 (EU: https://eu.api.otari.ai/api/v1).
# For a self-hosted gateway use e.g. http://localhost:8000/api/v1
OTARI_BASE_URL=https://api.otari.ai/api/v1
# Optional: an Otari key that may manage keys/users/budgets (e.g. a self-hosted master key).
# When set, every member gets their OWN Otari virtual key + weekly Otari budget ("managed" mode).
OTARI_ADMIN_KEY=
# Model to chat with (any Otari model id or provider:model selector). Open-weight and cheap by default.
OTARI_MODEL=mistralai/mistral-small-3
# Output cap per answer. Keeps answers short and Otari's up-front budget hold small.
OTARI_MAX_TOKENS=400
# Sampling temperature (default 0.3: steadier, more factual answers for kids).
OTARI_TEMPERATURE=0.3

# --- App ---
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string
GROUP_NAME=The Okafor family
PORT=3000
# Where members and the usage ledger are stored (JSON file).
DATA_FILE=./data/db.json
# Optional: Upstash Redis REST (Vercel's Upstash/KV integration injects these). When set, data lives in Redis.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Account email ---
# Choose ONE email provider. Sendliberty can send through a connected Gmail account without owning a domain.
# Sendliberty: connect Gmail with OAuth, create an API key, and set this value.
SENDLIBERTY_API_KEY=
# Required: the Gmail address connected to Sendliberty.
SENDLIBERTY_FROM=your-connected-gmail@gmail.com
# Optional endpoint override for automated tests; normally leave unset.
# SENDLIBERTY_API_URL=https://sendliberty.com/api/send
# Resend alternative: requires a verified sending domain and EMAIL_FROM.
RESEND_API_KEY=
EMAIL_FROM=Budget Buddy <accounts@yourdomain.com>
# Public canonical URL used in verification and password reset links.
APP_BASE_URL=https://budget-buddy-one-mu.vercel.app
# Optional Resend-compatible API endpoint (normally leave unset).
# RESEND_API_URL=https://api.resend.com/emails
